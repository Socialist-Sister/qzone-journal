{
  "name": "qzone-journal",
  "version": "0.3.0-alpha",
  "description": "Local-first QQ Space archive desktop application.",
  "author": "QZone Journal Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Socialist-Sister/qzone-journal.git"
  },
  "homepage": "https://github.com/Socialist-Sister/qzone-journal#readme",
  "bugs": {
    "url": "https://github.com/Socialist-Sister/qzone-journal/issues"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k -s first \"pnpm dev -- --host 127.0.0.1 --port 4173 --strictPort\" \"wait-on tcp:127.0.0.1:4173 && electron .\"",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:web": "vite build",
    "desktop:pack": "pnpm run build:web && electron-builder --dir",
    "desktop:dist": "pnpm run build:web && electron-builder --win nsis",
    "preview": "vite preview",
    "test:desktop": "pnpm run build:web && electron tests/electron-smoke.cjs",
    "test:collector": "electron tests/collector-process-smoke.cjs",
    "test:session": "electron tests/qzone-session-smoke.cjs",
    "test:archive": "node --test tests/archive-store.test.cjs tests/qzone-parser.test.cjs tests/relative-time.test.mjs",
    "test:ai-compat": "electron tests/ai-compat-smoke.cjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "io.github.qzonejournal.desktop",
    "productName": "空间备份",
    "copyright": "Copyright © 2026 QZone Journal Contributors",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/client/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "QZoneJournal-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
